{
  "components": {
    "schemas": {
      "AnalysisErrorCode": {
        "enum": [
          "file_too_large",
          "unsupported_media_type",
          "encrypted_pdf",
          "corrupt_pdf",
          "too_many_pages",
          "not_machine_readable",
          "empty_document",
          "rate_limited",
          "internal_error"
        ],
        "title": "AnalysisErrorCode",
        "type": "string"
      },
      "AnalysisResult": {
        "additionalProperties": false,
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "ats": {
            "$ref": "#/components/schemas/AtsScore"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/DocumentStats"
          },
          "fit": {
            "$ref": "#/components/schemas/RoleFit"
          },
          "missing_sections": {
            "items": {
              "$ref": "#/components/schemas/SectionKind"
            },
            "title": "Missing Sections",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "rubric_version": {
            "title": "Rubric Version",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/DetectedSection"
            },
            "title": "Sections",
            "type": "array"
          },
          "skills": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "title": "Skills",
            "type": "array"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "analysis_id",
          "created_at",
          "rubric_version",
          "model_version",
          "document",
          "sections",
          "missing_sections",
          "skills",
          "ats",
          "fit",
          "suggestions"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "AtsCheck": {
        "additionalProperties": false,
        "properties": {
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "weight": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "id",
          "label",
          "passed",
          "weight",
          "severity",
          "explanation"
        ],
        "title": "AtsCheck",
        "type": "object"
      },
      "AtsScore": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/AtsCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "rubric_version": {
            "title": "Rubric Version",
            "type": "string"
          },
          "score": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "score",
          "rubric_version",
          "checks"
        ],
        "title": "AtsScore",
        "type": "object"
      },
      "Body_analyze_v1_analyze_post": {
        "properties": {
          "job_description": {
            "anyOf": [
              {
                "maxLength": 20000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional target job posting to produce a gap analysis against.",
            "title": "Job Description"
          },
          "resume": {
            "contentMediaType": "application/octet-stream",
            "description": "Resume as a PDF, 5 MB maximum.",
            "title": "Resume",
            "type": "string"
          }
        },
        "required": [
          "resume"
        ],
        "title": "Body_analyze_v1_analyze_post",
        "type": "object"
      },
      "DetectedSection": {
        "additionalProperties": false,
        "properties": {
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Verbatim heading text as written.",
            "title": "Heading"
          },
          "kind": {
            "$ref": "#/components/schemas/SectionKind"
          },
          "location": {
            "$ref": "#/components/schemas/TextLocation"
          },
          "word_count": {
            "minimum": 0.0,
            "title": "Word Count",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "location",
          "word_count"
        ],
        "title": "DetectedSection",
        "type": "object"
      },
      "DocumentStats": {
        "additionalProperties": false,
        "properties": {
          "column_count": {
            "description": "Detected text columns on the densest page.",
            "minimum": 1.0,
            "title": "Column Count",
            "type": "integer"
          },
          "font_families": {
            "items": {
              "type": "string"
            },
            "title": "Font Families",
            "type": "array"
          },
          "has_images": {
            "title": "Has Images",
            "type": "boolean"
          },
          "has_tables": {
            "title": "Has Tables",
            "type": "boolean"
          },
          "machine_readable": {
            "description": "False when the resume is a scanned image with no extractable text layer.",
            "title": "Machine Readable",
            "type": "boolean"
          },
          "page_count": {
            "minimum": 1.0,
            "title": "Page Count",
            "type": "integer"
          },
          "text_in_header_footer": {
            "title": "Text In Header Footer",
            "type": "boolean"
          },
          "word_count": {
            "minimum": 0.0,
            "title": "Word Count",
            "type": "integer"
          }
        },
        "required": [
          "page_count",
          "word_count",
          "column_count",
          "machine_readable",
          "has_tables",
          "has_images",
          "text_in_header_footer",
          "font_families"
        ],
        "title": "DocumentStats",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/AnalysisErrorCode",
            "description": "Stable machine-readable failure identifier."
          },
          "message": {
            "description": "Human-readable explanation safe to display to the student.",
            "title": "Message",
            "type": "string"
          },
          "remediation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Concrete action the student can take to resolve the failure.",
            "title": "Remediation"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidenceStrength": {
        "enum": [
          "claimed",
          "demonstrated"
        ],
        "title": "EvidenceStrength",
        "type": "string"
      },
      "HealthResponse": {
        "properties": {
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "models_loaded": {
            "title": "Models Loaded",
            "type": "boolean"
          },
          "rubric_version": {
            "title": "Rubric Version",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "schema_version",
          "rubric_version",
          "model_version",
          "models_loaded"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobDescriptionMatch": {
        "additionalProperties": false,
        "properties": {
          "matched_skills": {
            "items": {
              "type": "string"
            },
            "title": "Matched Skills",
            "type": "array"
          },
          "missing_skills": {
            "items": {
              "$ref": "#/components/schemas/SkillGap"
            },
            "title": "Missing Skills",
            "type": "array"
          },
          "similarity": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Similarity",
            "type": "number"
          }
        },
        "required": [
          "similarity",
          "matched_skills",
          "missing_skills"
        ],
        "title": "JobDescriptionMatch",
        "type": "object"
      },
      "RoleFit": {
        "additionalProperties": false,
        "properties": {
          "job_description": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobDescriptionMatch"
              },
              {
                "type": "null"
              }
            ]
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/RolePrediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "predictions"
        ],
        "title": "RoleFit",
        "type": "object"
      },
      "RolePrediction": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "confidence"
        ],
        "title": "RolePrediction",
        "type": "object"
      },
      "SectionKind": {
        "enum": [
          "contact",
          "summary",
          "education",
          "experience",
          "skills",
          "projects",
          "certifications",
          "awards",
          "publications",
          "other"
        ],
        "title": "SectionKind",
        "type": "string"
      },
      "Severity": {
        "enum": [
          "critical",
          "high",
          "medium",
          "low"
        ],
        "title": "Severity",
        "type": "string"
      },
      "Skill": {
        "additionalProperties": false,
        "properties": {
          "canonical_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Identifier in the ESCO or O*NET taxonomy when matched.",
            "title": "Canonical Id"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceStrength",
            "description": "Demonstrated when the skill appears inside experience or project prose."
          },
          "found_in": {
            "items": {
              "$ref": "#/components/schemas/SectionKind"
            },
            "title": "Found In",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SkillSource"
          }
        },
        "required": [
          "name",
          "source",
          "evidence",
          "found_in",
          "confidence"
        ],
        "title": "Skill",
        "type": "object"
      },
      "SkillGap": {
        "additionalProperties": false,
        "properties": {
          "importance": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "type": "number"
          },
          "skill": {
            "title": "Skill",
            "type": "string"
          }
        },
        "required": [
          "skill",
          "importance"
        ],
        "title": "SkillGap",
        "type": "object"
      },
      "SkillSource": {
        "enum": [
          "gazetteer",
          "ner"
        ],
        "title": "SkillSource",
        "type": "string"
      },
      "Suggestion": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TextLocation"
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SectionKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "title",
          "detail"
        ],
        "title": "Suggestion",
        "type": "object"
      },
      "TextLocation": {
        "additionalProperties": false,
        "properties": {
          "excerpt": {
            "maxLength": 400,
            "title": "Excerpt",
            "type": "string"
          },
          "line_end": {
            "minimum": 0.0,
            "title": "Line End",
            "type": "integer"
          },
          "line_start": {
            "minimum": 0.0,
            "title": "Line Start",
            "type": "integer"
          },
          "page": {
            "description": "One-based page number.",
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "line_start",
          "line_end",
          "excerpt"
        ],
        "title": "TextLocation",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Analyzes student resumes for structure, ATS friendliness and role fit.",
    "title": "Resume Analyzer API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/analyze": {
      "post": {
        "operationId": "analyze_v1_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_v1_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upload exceeds the size limit."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Upload is not a PDF."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "PDF could not be analyzed."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many requests."
          }
        },
        "summary": "Analyze",
        "tags": [
          "analysis"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
